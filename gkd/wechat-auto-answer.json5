// 若你的 GKD 能添加整份订阅再用这个；否则用 app-rule-wechat.json5
// 安全默认：接听规则 enable 是 false，添加后不会马上点屏幕。
// 确认是家人专用平板后，再打开「自动接听语音和视频」。
// 横幅规则不在这份订阅里，见 global-incoming-banner.json5。
{
  id: 20260908,
  name: '微信自动接听',
  version: 3,
  author: 'wechat-auto-answer',
  categories: [{ key: 0, name: '家人通话' }],
  globalGroups: [],
  apps: [
    {
      id: 'com.tencent.mm',
      name: '微信',
      groups: [
        {
          key: 1,
          name: '自动接听语音和视频',
          desc: '默认关闭。只在同时看见「接听」和「挂断/拒绝」时点接听。看见「发送」就停。扬声器只在点过接听之后，并且只点「扬声器已关」。',
          enable: false,
          rules: [
            {
              key: 0,
              name: '来电界面点接听',
              fastQuery: true,
              actionDelay: 400,
              actionCd: 2000,
              actionMaximum: 2,
              resetMatch: 'activity',
              matches: [
                '[text="挂断"||text="拒绝"][visibleToUser=true]',
                '[text="接听"||text="接听通话"||text="接听视频"][visibleToUser=true]',
              ],
              excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
            },
            {
              key: 1,
              name: '来电界面点接听描述',
              fastQuery: false,
              actionDelay: 400,
              actionCdKey: 0,
              actionMaximumKey: 0,
              resetMatch: 'activity',
              matches: [
                '[desc="挂断"||desc="拒绝"][visibleToUser=true]',
                '[desc="接听"||desc="接听通话"||desc="接听视频"][visibleToUser=true]',
              ],
              excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
            },
            {
              key: 2,
              name: '点邀请你视频通话',
              fastQuery: true,
              actionDelay: 400,
              actionCd: 3000,
              actionMaximum: 2,
              resetMatch: 'activity',
              matches: '[text*="邀请你视频通话"][text!*="未接"][text!*="已结束"][text!*="已取消"][text.length<=24][visibleToUser=true]',
              excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
            },
            {
              key: 3,
              name: '点邀请你语音通话',
              fastQuery: true,
              actionDelay: 400,
              actionCd: 3000,
              actionMaximum: 2,
              resetMatch: 'activity',
              matches: '[text*="邀请你语音通话"][text!*="未接"][text!*="已结束"][text!*="已取消"][text.length<=24][visibleToUser=true]',
              excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
            },
            {
              key: 4,
              name: '打开已关闭的扬声器',
              preKeys: [0, 1],
              fastQuery: false,
              actionDelay: 500,
              actionCd: 5000,
              actionMaximum: 1,
              resetMatch: 'activity',
              matches: '[text="扬声器已关"||desc="扬声器已关"][visibleToUser=true]',
              excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
            },
          ],
        },
      ],
    },
  ],
}
