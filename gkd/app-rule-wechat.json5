// 贴到：GKD → 订阅 → 本地订阅 → 添加应用规则
// 如果列表里已经有「微信」，先删掉再贴这一份。
// 安全默认：enable 是 false。贴进去以后不会马上点屏幕。
// 确认这是家人知情的专用平板后，再在 GKD 里把「自动接听语音和视频」打开。
// 打开后会接听所有微信来电，GKD 不能按联系人名单过滤。
{
  id: 'com.tencent.mm',
  name: '微信',
  groups: [
    {
      key: 1,
      name: '自动接听语音和视频',
      desc: '默认关闭。只在同时看见「接听」和「挂断/拒绝」时点接听。看见「发送」就停。扬声器只在点过接听之后，并且只点「扬声器已关」。',
      enable: false,
      rules: [
        {
          key: 0,
          name: '来电界面点接听',
          fastQuery: true,
          actionDelay: 400,
          actionCd: 2000,
          actionMaximum: 2,
          resetMatch: 'activity',
          matches: [
            '[text="挂断"||text="拒绝"][visibleToUser=true]',
            '[text="接听"||text="接听通话"||text="接听视频"][visibleToUser=true]',
          ],
          excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
        },
        {
          key: 1,
          name: '来电界面点接听描述',
          fastQuery: false,
          actionDelay: 400,
          actionCdKey: 0,
          actionMaximumKey: 0,
          resetMatch: 'activity',
          matches: [
            '[desc="挂断"||desc="拒绝"][visibleToUser=true]',
            '[desc="接听"||desc="接听通话"||desc="接听视频"][visibleToUser=true]',
          ],
          excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
        },
        {
          key: 2,
          name: '点邀请你视频通话',
          fastQuery: true,
          actionDelay: 400,
          actionCd: 3000,
          actionMaximum: 2,
          resetMatch: 'activity',
          matches: '[text*="邀请你视频通话"][text!*="未接"][text!*="已结束"][text!*="已取消"][text.length<=24][visibleToUser=true]',
          excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
        },
        {
          key: 3,
          name: '点邀请你语音通话',
          fastQuery: true,
          actionDelay: 400,
          actionCd: 3000,
          actionMaximum: 2,
          resetMatch: 'activity',
          matches: '[text*="邀请你语音通话"][text!*="未接"][text!*="已结束"][text!*="已取消"][text.length<=24][visibleToUser=true]',
          excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
        },
        {
          key: 4,
          name: '打开已关闭的扬声器',
          preKeys: [0, 1],
          fastQuery: false,
          actionDelay: 500,
          actionCd: 5000,
          actionMaximum: 1,
          resetMatch: 'activity',
          matches: '[text="扬声器已关"||desc="扬声器已关"][visibleToUser=true]',
          excludeMatches: '[text="发送"||desc="发送"][visibleToUser=true]',
        },
      ],
    },
  ],
}
